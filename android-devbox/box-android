#!/usr/bin/env python3
import argparse
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

SDK = Path(os.environ.get("ANDROID_HOME", "/config/sdk"))
AVD = Path(os.environ.get("ANDROID_AVD_HOME", "/config/.android/avd"))
SYSTEM_IMAGE = "system-images;android-36;google_apis;x86_64"
PACKAGES = ["platform-tools", "emulator", "platforms;android-36", "build-tools;36.1.0", SYSTEM_IMAGE]
SERIAL = "emulator-5554"


def copy_package(source, target):
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".boxes-copy-", dir=target.parent) as temporary:
        staged = Path(temporary) / "package"
        shutil.copytree(source, staged)
        staged.rename(target)


def sdk():
    parser = argparse.ArgumentParser(description="Install or copy a private SDK. No license acceptance occurs at desktop startup.")
    sub = parser.add_subparsers(dest="operation", required=True)
    seed = sub.add_parser("seed")
    seed.add_argument("source", type=Path)
    install = sub.add_parser("install")
    install.add_argument("--accept-licenses", action="store_true", help="Explicitly accept Google's SDK licenses")
    sub.add_parser("licenses")
    sub.add_parser("status")
    args = parser.parse_args()
    if args.operation == "status":
        print(json.dumps({"sdk": str(SDK), "packages": {p: (SDK / p.replace(";", "/")).exists() for p in PACKAGES}}))
        return
    SDK.mkdir(parents=True, exist_ok=True)
    if args.operation == "seed":
        source = args.source.resolve(strict=True)
        if source == SDK.resolve() or source in SDK.resolve().parents or SDK.resolve() in source.parents:
            raise RuntimeError("Seed source and destination must be separate directories.")
        paths = ["cmdline-tools", "licenses"] + [value.replace(";", "/") for value in PACKAGES]
        for name in paths:
            if not (source / name).is_dir():
                raise RuntimeError(f"Seed is missing {name}.")
        for name in paths:
            target = SDK / name
            if target.exists():
                print(f"Retaining {target}")
            else:
                copy_package(source / name, target)
                print(f"Copied {name}")
        return
    tools = SDK / "cmdline-tools/latest"
    if not tools.exists():
        copy_package("/opt/android-tools/cmdline-tools", tools)
    manager = str(tools / "bin/sdkmanager")
    if args.operation == "licenses":
        subprocess.run([manager, f"--sdk_root={SDK}", "--licenses"], check=True)
        return
    if args.accept_licenses:
        subprocess.run([manager, f"--sdk_root={SDK}", "--licenses"], input=b"y\n" * 200, check=True)
    subprocess.run([manager, f"--sdk_root={SDK}", "--install", *PACKAGES], check=True)


def adb(*args, check=True):
    return subprocess.run([str(SDK / "platform-tools/adb"), "-s", SERIAL, *args],
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=15, check=check)


def emulator():
    parser = argparse.ArgumentParser(description="Control this instance's KVM emulator. Desktop startup never starts it.")
    parser.add_argument("operation", choices=["start", "stop", "status"])
    parser.add_argument("--wait", type=int, default=0, metavar="SECONDS")
    args = parser.parse_args()
    if not 0 <= args.wait <= 900:
        raise RuntimeError("--wait must be between 0 and 900 seconds.")
    android = AVD.parent
    android.mkdir(parents=True, exist_ok=True)
    with (android / "box-emulator.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        executable = SDK / "emulator/emulator"
        if not executable.exists() or not (SDK / "platform-tools/adb").exists():
            if args.operation == "status":
                print(json.dumps({"state": "sdk-missing", "booted": False}))
                return
            if args.operation == "stop":
                print("Emulator already stopped. SDK is not installed.")
                return
            raise RuntimeError("Install or seed the SDK with box-sdk first.")
        process = subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", "qemu-system.*-avd boxes"], capture_output=True, text=True)
        running = process.returncode == 0
        if args.operation == "status":
            result = adb("shell", "getprop", "sys.boot_completed", check=False) if running else None
            print(json.dumps({"state": "running" if running else "stopped", "booted": bool(result and result.stdout.strip() == "1")}))
            return
        if args.operation == "stop":
            if running:
                adb("emu", "kill")
                deadline = time.monotonic() + 30
                while time.monotonic() < deadline:
                    result = subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", "qemu-system.*-avd boxes"], capture_output=True)
                    if result.returncode:
                        print("Emulator stopped.")
                        return
                    time.sleep(0.5)
                raise RuntimeError("Emulator did not stop within 30 seconds.")
            print("Emulator already stopped.")
            return
        if not os.access("/dev/kvm", os.R_OK | os.W_OK):
            raise RuntimeError("/dev/kvm must be readable and writable by abc.")
        if not running:
            AVD.mkdir(parents=True, exist_ok=True)
            if not (AVD / "boxes.ini").exists():
                subprocess.run([str(SDK / "cmdline-tools/latest/bin/avdmanager"), "create", "avd", "--name", "boxes",
                                "--package", SYSTEM_IMAGE, "--device", "pixel_8"], input="no\n", text=True, check=True)
            result = subprocess.run([str(executable), "-accel-check"], capture_output=True, text=True)
            if result.returncode:
                raise RuntimeError(result.stdout + result.stderr)
            environment = os.environ.copy()
            environment["QT_QPA_PLATFORM"] = "xcb"
            environment.setdefault("DISPLAY", ":0")
            with (android / "emulator.log").open("ab") as log:
                child = subprocess.Popen([str(executable), "-avd", "boxes", "-port", "5554", "-gpu", "swiftshader",
                                          "-no-audio", "-no-boot-anim", "-no-snapshot", "-no-nested-warnings",
                                          "-memory", "2048", "-cores", "4"], stdin=subprocess.DEVNULL,
                                         stdout=log, stderr=log, env=environment, start_new_session=True)
            time.sleep(2)
            if child.poll() is not None:
                raise RuntimeError(f"Emulator exited. Read {android / 'emulator.log'}.")
        if args.wait:
            deadline = time.monotonic() + args.wait
            while time.monotonic() < deadline:
                result = adb("shell", "getprop", "sys.boot_completed", check=False)
                if result.returncode == 0 and result.stdout.strip() == "1":
                    print("Android boot completed.")
                    return
                time.sleep(2)
            raise RuntimeError("Android boot timed out. The emulator remains running. Inspect its log or stop it.")
        print("Emulator running. Use status or start --wait SECONDS to check boot.")


if __name__ == "__main__":
    try:
        if Path(sys.argv[0]).name == "box-emulator":
            emulator()
        else:
            with Path("/config/.box-sdk.lock").open("a") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                sdk()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
